# Cache headers for the static site. `headers()` in next.config.ts does not run in an export — there
# is no server to run it — so this file is the only thing that sets them, and the Cloudflare asset
# store is what reads it.
#
# HTML and the .txt router payloads beside it are deliberately absent: they change with every deploy
# and the default (revalidate against the ETag) is what they should do.

# The photographs. scripts/derive-images.mjs writes /img/<stem>-<width>.<format>, so the name carries
# both the source and the size; a new photograph arrives under a new name (content/image-manifest.json
# gives every image its own id). If a master is ever *replaced* under its existing name, the ?v token
# convention used for the fonts applies here too.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed build output: the filename changes whenever the bytes do.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The faces are content-stable (scripts/subset-fonts.py bumps the ?v token when they are not).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/og.jpg
  Cache-Control: public, max-age=604800
